{
  "name": "@region-snap/core",
  "version": "0.1.0",
  "description": "Drag to select any region of a web page and capture it as an image. Framework-agnostic core.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "html2canvas": "^1.4.1"
  },
  "keywords": [
    "screenshot",
    "region",
    "selection",
    "crop",
    "capture",
    "html2canvas",
    "ocr"
  ],
  "license": "AGPL-3.0-only",
  "author": "Jacky010",
  "homepage": "https://github.com/Jacky010/region-snap#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacky010/region-snap.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Jacky010/region-snap/issues"
  }
}
