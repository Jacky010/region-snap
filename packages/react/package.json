{
  "name": "@region-snap/react",
  "version": "0.1.2",
  "description": "Drag to select any region of a web page and capture it as an image. React component.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@region-snap/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "keywords": [
    "react",
    "screenshot",
    "region",
    "selection",
    "crop",
    "capture",
    "ocr"
  ],
  "license": "AGPL-3.0-only",
  "author": "Jacky010",
  "homepage": "https://jacky010.github.io/region-snap-website/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacky010/region-snap.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Jacky010/region-snap/issues"
  }
}
