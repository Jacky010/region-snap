{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@region-snap/core": ["./packages/core/src/index.ts"],
      "@region-snap/vue": ["./packages/vue/src/index.ts"],
      "@region-snap/react": ["./packages/react/src/index.tsx"]
    }
  },
  "include": ["packages/*/src", "packages/*/test", "playground/src/**/*.ts", "playground/src/**/*.tsx"]
}
